+++ b/noisemodelling-pathfinder/src/test/scripts/repro_issue_1144.py
@@ -0,0 +1,78 @@
+#!/usr/bin/env python3
+"""Manual stock-only reproduction of issue #1144; no engine modifications.
+
+Use an existing checkout of the public reproduction bundle. Inputs remain
+untouched; every run receives a new H2 working copy. This is not a CI test and
+does not download software or data. GPL-3.0, as the surrounding project.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import time
+
+
+INPUTS = {
+    "L050": "5a0c8d3ab3567173eafe0cf2f4118a8b85ced13be14157b858ed426c225742da",
+    "L250": "99d6a486c241744f31a2f1a4062017e194c8b1977030cf2df59817c757c8f711",
+    "L350": "c79a38072af74b55213350eed56a23b2b8fe32f97a505a4542f4bdb57ded0647",
+}
+SCRIPT_SHA256 = "5601c4a7a96c089236740d9cb46b03f52b0b1f09d5cbb602acbd1af43e7c78a4"
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--stock", type=Path, required=True, help="Unmodified 5.0.1 no-GUI distribution")
+    parser.add_argument("--java-home", type=Path, required=True)
+    parser.add_argument("--bundle", type=Path, required=True, help="Public issue #1144 bundle checkout")
+    parser.add_argument("--out", type=Path, required=True, help="New output directory")
+    args = parser.parse_args()
+    stock, jdk, bundle, out = [p.resolve() for p in (args.stock, args.java_home, args.bundle, args.out)]
+    script = bundle / "repro_full_map.groovy"
+    if sha(script) != SCRIPT_SHA256:
+        raise ValueError("Unexpected reproduction script SHA-256")
+    for case, expected in INPUTS.items():
+        if sha(bundle / "inputs" / case / "h2gisdb.mv.db") != expected:
+            raise ValueError("Unexpected pristine input SHA-256: " + case)
+    out.mkdir(parents=True, exist_ok=False)
+    env = {k: v for k, v in os.environ.items()
+           if k not in ("JAVA_TOOL_OPTIONS", "JDK_JAVA_OPTIONS", "_JAVA_OPTIONS", "CLASSPATH",
+                        "LD_PRELOAD", "LD_AUDIT", "LD_LIBRARY_PATH")
+           and not k.startswith(("N5_", "TAKT_"))}
+    env.update(JAVA_HOME=str(jdk), PATH=str(jdk / "bin") + os.pathsep + env.get("PATH", ""),
+               N5_STOCK=str(stock), JAVA_OPTS="-Xms128m -Xmx4g -XX:ActiveProcessorCount=1")
+    results = []
+    for case, expected in INPUTS.items():
+        work = out / case
+        work.mkdir()
+        original = bundle / "inputs" / case / "h2gisdb.mv.db"
+        shutil.copyfile(original, work / "h2gisdb.mv.db")
+        command = [str(stock / "bin/wps_scripts"), "-w", str(work), "-s", str(script)]
+        started = time.perf_counter()
+        with (work / "stock.log").open("wb") as log:
+            run = subprocess.run(command, cwd=work, env=env, stdout=log,
+                                 stderr=subprocess.STDOUT, timeout=600)
+        elapsed = time.perf_counter() - started
+        log = (work / "stock.log").read_text(errors="replace")
+        results.append({"case": case, "input_sha256": expected, "command": command,
+                        "returncode": run.returncode, "diagnostic_elapsed_s": elapsed,
+                        "empty_path_exception": "IndexOutOfBoundsException: Index 0 out of bounds for length 0" in log
+                            and "PathFinder.computeReflexion(PathFinder.java:761)" in log,
+                        "csv_exists": (work / "RECEIVERS_LEVEL.csv").is_file(),
+                        "pristine_source_unchanged": sha(original) == expected})
+        (out / "RESULT.json").write_text(json.dumps({"cases": results}, indent=2) + "\n")
+        print(case, "rc", run.returncode, "empty-path", results[-1]["empty_path_exception"], flush=True)
+    if not all(row["pristine_source_unchanged"] for row in results):
+        raise RuntimeError("Pristine source unexpectedly changed")
+    return 1 if any(row["returncode"] for row in results) else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
