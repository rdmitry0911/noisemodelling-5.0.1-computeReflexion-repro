+package org.noise_planet.noisemodelling.pathfinder;
+
+import org.junit.jupiter.api.Test;
+import org.locationtech.jts.geom.Coordinate;
+import org.locationtech.jts.geom.Envelope;
+import org.locationtech.jts.geom.GeometryFactory;
+import org.noise_planet.noisemodelling.pathfinder.path.MirrorReceiversCompute;
+import org.noise_planet.noisemodelling.pathfinder.path.Scene;
+import org.noise_planet.noisemodelling.pathfinder.profilebuilder.ProfileBuilder;
+import org.noise_planet.noisemodelling.pathfinder.profilebuilder.Wall;
+import org.noise_planet.noisemodelling.pathfinder.utils.geometry.Orientation;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+
+/**
+ * Small stock-only witness for issue #1144: one building, source and receiver.
+ * The source-on-wall boundary condition is also discussed in upstream PR #1005.
+ * No attenuation calculation, database or external fixture is needed.
+ *
+ * This is a proposed regression, pending agreement on the intended handling of
+ * this geometry. It deliberately does not prescribe an acoustic result or add
+ * an exception handler to the engine.
+ */
+public class TestEmptyReflectionPath {
+    @Test
+    public void sourceOnWallDoesNotIndexAnEmptyReflectionPath() {
+        assertDoesNotThrow(TestEmptyReflectionPath::computeSourceOnWall);
+    }
+
+    /** Run the same witness directly against an unmodified release classpath. */
+    public static void main(String[] args) {
+        computeSourceOnWall();
+    }
+
+    private static void computeSourceOnWall() {
+        GeometryFactory factory = new GeometryFactory();
+        ProfileBuilder builder = new ProfileBuilder();
+        builder.addBuilding(new Coordinate[] {
+                new Coordinate(0, 0, 10), new Coordinate(10, 0, 10),
+                new Coordinate(10, 10, 10), new Coordinate(0, 10, 10)
+        });
+        builder.finishFeeding();
+
+        Scene scene = new Scene(builder);
+        scene.addReceiver(new Coordinate(5, -20, 4));
+        scene.addSource(factory.createPoint(new Coordinate(5, 0, 1)));
+        scene.setComputeHorizontalDiffraction(false);
+        scene.setComputeVerticalDiffraction(false);
+        scene.setReflexionOrder(1);
+        scene.maxSrcDist = 180;
+        scene.maxRefDist = 80;
+
+        PathFinder finder = new PathFinder(scene);
+        finder.setThreadCount(1);
+        Coordinate receiver = scene.receivers.get(0);
+        Envelope envelope = new Envelope(receiver);
+        envelope.expandBy(scene.maxSrcDist);
+        List<Wall> walls = builder.getWallsIn(envelope);
+        MirrorReceiversCompute mirrors = new MirrorReceiversCompute(walls, receiver,
+                scene.reflexionOrder, scene.maxSrcDist, scene.maxRefDist);
+
+        finder.computeReflexion(new PathFinder.ReceiverPointInfo(1, 1, receiver),
+                new PathFinder.SourcePointInfo(1, 1,
+                        scene.sourceGeometries.get(0).getCoordinate(), 1.0, new Orientation()),
+                mirrors, new DefaultCutPlaneVisitor(true, scene),
+                CutPlaneVisitor.PathSearchStrategy.CONTINUE);
+    }
+}
